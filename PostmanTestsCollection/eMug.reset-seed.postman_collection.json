{
  "info": {
    "name": "eMug - Reset si seed",
    "description": "ATENTIE: sterge toate produsele, categoriile, furnizorii si livrarile, apoi adauga date de test. Doar pentru dezvoltare. Utilizatorii nu sunt stersi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7263"
    },
    {
      "key": "adminEmail",
      "value": "admin@emug.com"
    },
    {
      "key": "adminPassword",
      "value": "ParolaPuternica.1"
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login ok\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"adminToken\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "2. Sterge tot (produse, categorii, furnizori, livrari)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = pm.collectionVariables.get(\"baseUrl\");",
              "const token = pm.collectionVariables.get(\"adminToken\");",
              "const headers = { \"Authorization\": \"Bearer \" + token, \"Content-Type\": \"application/json\" };",
              "const call = (method, path, body) => new Promise((resolve, reject) => {",
              "  const opts = { url: base + path, method, header: headers };",
              "  if (body !== undefined) opts.body = { mode: \"raw\", raw: JSON.stringify(body) };",
              "  pm.sendRequest(opts, (err, res) => err ? reject(err) : resolve(res));",
              "});",
              "",
              "const wipe = async (list, item) => {",
              "  const res = await call(\"GET\", list);",
              "  const rows = res.json();",
              "  let deleted = 0;",
              "  for (const r of rows) {",
              "    const d = await call(\"DELETE\", item + \"/\" + r.id);",
              "    if (d.code === 204) deleted++;",
              "  }",
              "  return { total: rows.length, deleted };",
              "};",
              "",
              "const products = await wipe(\"/api/products\", \"/api/products\");",
              "const categories = await wipe(\"/api/categories\", \"/api/categories\");",
              "const suppliers = await wipe(\"/api/suppliers\", \"/api/suppliers\");",
              "const delivery = await wipe(\"/api/delivery-methods\", \"/api/delivery-methods\");",
              "",
              "pm.test(\"Produse sterse (\" + products.deleted + \")\", () => pm.expect(products.deleted).to.eql(products.total));",
              "pm.test(\"Categorii sterse (\" + categories.deleted + \")\", () => pm.expect(categories.deleted).to.eql(categories.total));",
              "pm.test(\"Furnizori stersi (\" + suppliers.deleted + \")\", () => pm.expect(suppliers.deleted).to.eql(suppliers.total));",
              "pm.test(\"Livrari sterse (\" + delivery.deleted + \")\", () => pm.expect(delivery.deleted).to.eql(delivery.total));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      }
    },
    {
      "name": "3. Adauga date de test",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = pm.collectionVariables.get(\"baseUrl\");",
              "const token = pm.collectionVariables.get(\"adminToken\");",
              "const headers = { \"Authorization\": \"Bearer \" + token, \"Content-Type\": \"application/json\" };",
              "const call = (method, path, body) => new Promise((resolve, reject) => {",
              "  const opts = { url: base + path, method, header: headers };",
              "  if (body !== undefined) opts.body = { mode: \"raw\", raw: JSON.stringify(body) };",
              "  pm.sendRequest(opts, (err, res) => err ? reject(err) : resolve(res));",
              "});",
              "",
              "const create = async (path, body) => {",
              "  const res = await call(\"POST\", path, body);",
              "  pm.test(\"POST \" + path + \" \" + (body.name || \"\") + \" => 201\", () => pm.expect(res.code).to.eql(201));",
              "  return res.code === 201 ? res.json().id : null;",
              "};",
              "",
              "const cats = {};",
              "for (const name of [\"Casti\", \"Mouse\", \"Tastaturi\", \"Monitoare\", \"Incarcatoare\"]) {",
              "  cats[name] = await create(\"/api/categories\", { name });",
              "}",
              "",
              "const sups = {};",
              "for (const name of [\"Logitech\", \"Samsung\", \"Anker\"]) {",
              "  sups[name] = await create(\"/api/suppliers\", { name, contactEmail: \"contact@\" + name.toLowerCase() + \".com\" });",
              "}",
              "",
              "const dels = {};",
              "dels[\"Curier\"] = await create(\"/api/delivery-methods\", { name: \"Curier\", price: 15.99, estimatedDays: 2 });",
              "dels[\"Ridicare personala\"] = await create(\"/api/delivery-methods\", { name: \"Ridicare personala\", price: 0, estimatedDays: 1 });",
              "const allDels = Object.values(dels);",
              "",
              "const products = [",
              "  [\"Casti Bluetooth X\", \"Casti wireless cu microfon\", \"Bluetooth 5.3, 30h baterie, 250g\", 199.99, 25, \"Casti\", \"Logitech\", allDels],",
              "  [\"Casti Gaming Pro\", \"Casti cu sunet surround 7.1\", \"USB, 7.1 surround, microfon detasabil\", 249.5, 12, \"Casti\", \"Logitech\", allDels],",
              "  [\"Mouse Wireless M3\", \"Mouse ergonomic fara fir\", \"2.4GHz, 1600 DPI, 12 luni baterie\", 89.9, 40, \"Mouse\", \"Logitech\", allDels],",
              "  [\"Mouse Gaming RGB\", \"Mouse cu iluminare RGB\", \"USB, 16000 DPI, 8 butoane\", 129, 18, \"Mouse\", \"Samsung\", allDels],",
              "  [\"Tastatura Mecanica K8\", \"Tastatura mecanica compacta\", \"Switch-uri rosii, layout 75%, USB-C\", 279, 15, \"Tastaturi\", \"Logitech\", allDels],",
              "  [\"Monitor 27 QHD\", \"Monitor 27 inch rezolutie QHD\", \"2560x1440, 144Hz, IPS, HDMI + DisplayPort\", 1099, 7, \"Monitoare\", \"Samsung\", [dels[\"Curier\"]]],",
              "  [\"Incarcator Rapid 65W\", \"Incarcator USB-C pentru laptop si telefon\", \"65W, GaN, 2 porturi USB-C\", 119, 60, \"Incarcatoare\", \"Anker\", allDels],",
              "];",
              "",
              "for (const [name, description, specifications, price, stock, cat, sup, deliveryMethodIds] of products) {",
              "  await create(\"/api/products\", {",
              "    name, description, specifications, price, stock, imageUrl: null,",
              "    categoryId: cats[cat], supplierId: sups[sup], deliveryMethodIds",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      }
    },
    {
      "name": "4. Verificare",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "pm.test(\"Exista 7 produse\", () => pm.expect(list).to.have.lengthOf(7));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}